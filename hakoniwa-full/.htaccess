<IfModule mod_headers.c>
  Header set X-Robots-Tag "noindex, nofollow, noarchive"
</IfModule>
# ---- 配信の軽量化（hakoniwa-tools/build/build.js が js/c/<かたまり>.<hash>.js と .br・.gz を作る。どのモジュールが無くても壊れないように IfModule で包む） ----
# 1) 事前に圧縮した版を返す：ブラウザが br（brotli）を受け取れるなら .js.br、gzip なら .js.gz（無ければふつうの .js）
<IfModule mod_mime.c>
  <FilesMatch "\.js\.br$">
    ForceType "application/javascript; charset=utf-8"
  </FilesMatch>
  <FilesMatch "\.js\.gz$">
    ForceType "application/javascript; charset=utf-8"
  </FilesMatch>
  AddEncoding br .br
  AddEncoding gzip .gz
  <IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTP:Accept-Encoding} \bbr\b
    RewriteCond %{REQUEST_FILENAME}\.br -f
    # 書き換え先は %{REQUEST_URI}（URL の絶対パス）。置いた場所がサブフォルダでも RewriteBase なしで動く。?v= はそのまま付いていく
    RewriteRule \.js$ %{REQUEST_URI}.br [E=no-gzip:1,E=no-brotli:1,L]
    RewriteCond %{HTTP:Accept-Encoding} \bgzip\b
    RewriteCond %{REQUEST_FILENAME}\.gz -f
    RewriteRule \.js$ %{REQUEST_URI}.gz [E=no-gzip:1,E=no-brotli:1,L]
    # 圧縮済みのファイルはサーバでもう一度圧縮しない
    RewriteRule \.js\.(br|gz)$ - [E=no-gzip:1,E=no-brotli:1]
  </IfModule>
</IfModule>
# 2) その場で圧縮（mod_deflate があるサーバだけ。圧縮済みのファイルは上の no-gzip で外れる）
<IfModule mod_filter.c>
  <IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript application/json image/svg+xml
  </IfModule>
</IfModule>
<IfModule mod_headers.c>
  # 圧縮の有無で中身が変わるので、途中のキャッシュに Accept-Encoding で分けてもらう
  <FilesMatch "\.(js|br|gz|html?|css)$">
    Header merge Vary Accept-Encoding
  </FilesMatch>
  # 3) かたまり（js/c/<名前>.<内容の hash 10桁>.js）は1年キャッシュ。中身が変わると名前が変わり、index.html の目録が新しい名前を指すので古い版は使われない
  <FilesMatch "^[a-z0-9-]+\.[0-9a-f]{10}\.js(\.br|\.gz)?$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # index.html は毎回たしかめる（目録と新しいかたまりの名前をすぐ届けるため）
  <FilesMatch "\.html?$">
    Header set Cache-Control "no-cache, private"
  </FilesMatch>
</IfModule>
